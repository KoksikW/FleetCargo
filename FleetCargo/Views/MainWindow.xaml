<Window x:Class="FleetCargo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FleetCargo.Views"
        xmlns:vm="clr-namespace:FleetCargo.ViewModels"
        Title="Fleet &amp; Cargo — управління автопарком та маршрутами"
        Width="1100" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" FontSize="14">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="16,10">
            <StackPanel>
                <TextBlock Text="Fleet &amp; Cargo" FontSize="20"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Логістична система управління автопарком та маршрутами"
                           Foreground="#D6E4FF"/>
            </StackPanel>
        </Border>

        <!-- Модулі -->
        <TabControl Grid.Row="1" Margin="12" Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Автопарк"><views:VehiclesView/></TabItem>
            <TabItem Header="Водії"><views:DriversView/></TabItem>
            <TabItem Header="Рейси"><views:TripsView/></TabItem>
            <TabItem Header="Звіти"><views:ReportsView/></TabItem>
        </TabControl>

        <!-- Рядок стану -->
        <StatusBar Grid.Row="2">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding TodayText}"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding RecordsText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
