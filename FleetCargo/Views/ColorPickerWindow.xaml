<Window x:Class="FleetCargo.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Колір інтерфейсу" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="18">
        <TextBlock Text="Виберіть колір із палітри або налаштуйте власний" FontWeight="SemiBold"/>

        <!-- Палітра готових кольорів -->
        <UniformGrid x:Name="PaletteGrid" Columns="12" Margin="0,10,0,12"/>

        <!-- Власний колір: RGB та код -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Червоний" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=RedSlider, StringFormat=0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Зелений" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider, StringFormat=0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Синій" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider, StringFormat=0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Код кольору:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="HexBox" Width="100" Padding="6,4" TextChanged="OnHexChanged"/>
        </StackPanel>

        <!-- Попередній перегляд -->
        <Border x:Name="Preview" Margin="0,14,0,0" Padding="16,10" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Fleet &amp; Cargo" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Так виглядатиме заголовок вікна" Foreground="White" Opacity="0.85"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="HintText" Foreground="#6B7785" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   MinHeight="16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="За замовчуванням" Padding="12,6" Margin="0,0,8,0" Click="OnResetClick"/>
            <Button Content="Скасувати" Padding="12,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Застосувати" Padding="12,6" IsDefault="True" Click="OnApplyClick"/>
        </StackPanel>
    </StackPanel>
</Window>
