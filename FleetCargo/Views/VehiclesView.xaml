<UserControl x:Class="FleetCargo.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Список автомобілів -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Додати" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="Редагувати" Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditCommand}"/>
                    <Button Content="Видалити" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DeleteCommand}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="260" HorizontalAlignment="Left"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <Expander Grid.Row="1" Header="Розширений пошук" Margin="0,0,0,10">
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Номер, марка або модель"/>
                                <TextBox Width="200" HorizontalAlignment="Left" Margin="0,2,0,0"
                                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Тип збігу"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton Content="Містить" IsChecked="{Binding PartialMatch}" Margin="0,0,12,0"/>
                                <RadioButton Content="Точний збіг" IsChecked="{Binding ExactMatch}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Статус"/>
                            <ComboBox Width="130" HorizontalAlignment="Left" Margin="0,2,0,0"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding StatusFilter}"/>
                        </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Пробіг від, км"/>
                                <TextBox Width="90" HorizontalAlignment="Left" Margin="0,2,0,0"
                                         Text="{Binding MileageFromText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Пробіг до, км"/>
                                <TextBox Width="90" HorizontalAlignment="Left" Margin="0,2,0,0"
                                         Text="{Binding MileageToText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Наступне ТО не пізніше"/>
                                <DatePicker Width="140" HorizontalAlignment="Left" Margin="0,2,0,0" SelectedDate="{Binding ServiceBeforeDate}"/>
                            </StackPanel>
                        </WrapPanel>
                    <TextBlock Text="{Binding SearchError}" Style="{StaticResource ErrorText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Знайти" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="Скинути" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetSearchCommand}"/>
                        <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Vehicles}"
                      SelectedItem="{Binding SelectedVehicle}"
                      RowStyle="{StaticResource AlertRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер" Binding="{Binding PlateNumber}" Width="110"/>
                    <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="130"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="130"/>
                    <DataGridTextColumn Header="Пробіг, км" Binding="{Binding Mileage}" Width="110"/>
                    <DataGridTextColumn Header="Наступне ТО"
                        Binding="{Binding NextServiceDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                    <DataGridTextColumn Header="Страхування до"
                        Binding="{Binding InsuranceEndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="130"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Попередження про ТО та страхування" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="Жовтий колір — термін настає протягом 14 днів, червоний — термін минув."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Права панель: картка вибраного запису або форма редагування -->
        <Grid Grid.Column="1" Width="300" Margin="12,0,0,0">
            <!-- Картка -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Картка автомобіля" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource PhotoFrame}">
                            <Grid>
                                <TextBlock Text="Фото відсутнє" Style="{StaticResource NoPhotoText}"
                                           Visibility="{Binding NoSelectedPhoto, Converter={StaticResource BoolToVis}}"/>
                                <Image Source="{Binding SelectedPhoto}" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SelectedVehicle.PlateNumber}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedVehicle.Title}" Margin="0,0,0,0"/>
                        <TextBlock Text="Технічні примітки" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedVehicle.Notes}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</UserControl>
