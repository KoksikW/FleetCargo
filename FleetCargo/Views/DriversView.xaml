<UserControl x:Class="FleetCargo.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Додати" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}"/>
                <Button Content="Редагувати" Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditCommand}"/>
                <Button Content="Видалити" Style="{StaticResource SecondaryButton}"
                        Command="{Binding DeleteCommand}" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="260" HorizontalAlignment="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Drivers}"
                  SelectedItem="{Binding SelectedDriver}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Прізвище" Binding="{Binding LastName}" Width="160"/>
                <DataGridTextColumn Header="Ім'я" Binding="{Binding FirstName}" Width="140"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,10,0,0"
                   Text="Водія, який має рейси, видалити не можна. Водія зі статусом «В дорозі» не можна призначити на новий рейс."/>
    </Grid>
</UserControl>
