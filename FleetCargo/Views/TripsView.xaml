<UserControl x:Class="FleetCargo.Views.TripsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель «Новий рейс» -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Новий рейс" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Дата початку"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Margin="0,2,0,8"/>

                    <TextBlock Text="Дата завершення"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Margin="0,2,0,8"/>

                    <Button Content="Знайти доступні ресурси"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding FindAvailableCommand}" Margin="0,0,0,10"/>

                    <TextBlock Text="Автомобіль"/>
                    <ComboBox ItemsSource="{Binding FreeVehicles}"
                              SelectedItem="{Binding SelectedVehicle}" Margin="0,2,0,8"/>

                    <TextBlock Text="Водій"/>
                    <ComboBox ItemsSource="{Binding FreeDrivers}"
                              SelectedItem="{Binding SelectedDriver}" Margin="0,2,0,8"/>

                    <TextBlock Text="Вантаж"/>
                    <ComboBox ItemsSource="{Binding CargoList}"
                              SelectedItem="{Binding SelectedCargo}" Margin="0,2,0,8"/>

                    <TextBlock Text="Звідки"/>
                    <TextBox Text="{Binding Origin}" Margin="0,2,0,8"/>

                    <TextBlock Text="Куди"/>
                    <TextBox Text="{Binding Destination}" Margin="0,2,0,12"/>

                    <Button Content="Створити рейс" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateTripCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Таблиця рейсів, дії та доступні ресурси -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding Trips}"
                      SelectedItem="{Binding SelectedTrip}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Автомобіль" Binding="{Binding VehicleName}" Width="140"/>
                    <DataGridTextColumn Header="Водій" Binding="{Binding DriverName}" Width="140"/>
                    <DataGridTextColumn Header="Звідки" Binding="{Binding Origin}" Width="100"/>
                    <DataGridTextColumn Header="Куди" Binding="{Binding Destination}" Width="100"/>
                    <DataGridTextColumn Header="Початок"
                        Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                    <DataGridTextColumn Header="Кінець"
                        Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Завершити рейс" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompleteTripCommand}"/>
                <Button Content="Експорт маршрутного листа"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Доступні ресурси на обраний період" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding AvailableResources}" Height="70"
                             BorderThickness="0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
