<UserControl x:Class="FleetCargo.Views.TripsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Вантажі" Style="{StaticResource SecondaryButton}"
                    Click="OnCargoClick" Margin="0"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Новий рейс" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewTripCommand}"/>
                <Button Content="Завершити рейс" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompleteTripCommand}"/>
                <Button Content="Експорт маршрутного листа" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </DockPanel>

        <Expander Grid.Row="1" Header="Розширений пошук" Margin="0,0,0,10">
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Маршрут, авто, водій або вантаж"/>
                                <TextBox Width="200" HorizontalAlignment="Left" Margin="0,2,0,0"
                                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Тип збігу"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton Content="Містить" IsChecked="{Binding PartialMatch}" Margin="0,0,12,0"/>
                                <RadioButton Content="Точний збіг" IsChecked="{Binding ExactMatch}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Статус"/>
                            <ComboBox Width="130" HorizontalAlignment="Left" Margin="0,2,0,0"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding StatusFilter}"/>
                        </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Період з"/>
                                <DatePicker Width="140" HorizontalAlignment="Left" Margin="0,2,0,0" SelectedDate="{Binding FilterFrom}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Період по"/>
                                <DatePicker Width="140" HorizontalAlignment="Left" Margin="0,2,0,0" SelectedDate="{Binding FilterTo}"/>
                            </StackPanel>
                        </WrapPanel>
                    <TextBlock Text="{Binding SearchError}" Style="{StaticResource ErrorText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Знайти" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="Скинути" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetSearchCommand}"/>
                        <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Trips}"
                      SelectedItem="{Binding SelectedTrip}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Автомобіль" Binding="{Binding VehicleName}" Width="140"/>
                    <DataGridTextColumn Header="Водій" Binding="{Binding DriverName}" Width="140"/>
                    <DataGridTextColumn Header="Звідки" Binding="{Binding Origin}" Width="100"/>
                    <DataGridTextColumn Header="Куди" Binding="{Binding Destination}" Width="100"/>
                    <DataGridTextColumn Header="Початок"
                        Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                    <DataGridTextColumn Header="Кінець"
                        Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
    </Grid>
</UserControl>
