<Window x:Class="FleetCargo.Views.AuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FleetCargo.Views"
        Title="Авторство" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI" FontSize="14">
    <Border Padding="22">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22">
                <views:AuthorView/>
            </Border>
            <Button Content="Закрити" Style="{StaticResource PrimaryButton}" IsCancel="True"
                    IsDefault="True" HorizontalAlignment="Right" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
